APP_NAME=UniSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unisphere
DB_USERNAME=unisphere
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Optional: switch to redis when running docker-compose
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@unisphere.test"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateway (sandbox only for the academic version)
PAYMENT_SANDBOX=true

# Firebase Cloud Messaging (push notifications) - fill in later
FCM_SERVER_KEY=
